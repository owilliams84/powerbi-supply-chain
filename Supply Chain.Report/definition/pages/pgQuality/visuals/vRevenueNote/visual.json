                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "'Sales' is price times quantity before discount, on every order including the cancelled ones. The money that changed hands is 'Order Item Total', on orders that shipped. Summing 'Sales' overstates it by 16%.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#4A5768"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "",
                    "textStyle": {
                      "fontSize": "4pt",
                      "color": "#4A5768"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "'Order Profit Per Order' is per line, not per order, and 'Benefit per order' and 'Sales per customer' are exact copies of other columns under misleading names.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#4A5768"
                    }
                  }
                ]
              }
            ]
          }
