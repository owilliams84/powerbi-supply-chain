		source =
				let
				    Source = Csv.Document(Web.Contents("https://raw.githubusercontent.com/owilliams84/powerbi-supply-chain/main/data/fact_order_line_2015.csv"), [Delimiter=",", Columns=20, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    #"Applied Types" = Table.TransformColumnTypes(#"Promoted Headers", {{"LineID", Int64.Type}, {"OrderID", Int64.Type}, {"Date", type date}, {"ShipDate", type date}, {"CustomerKey", Int64.Type}, {"ProductKey", Int64.Type}, {"GeoKey", Int64.Type}, {"ModeKey", Int64.Type}, {"OutcomeKey", Int64.Type}, {"PromisedDays", Int64.Type}, {"ActualDays", Int64.Type}, {"DaysLate", Int64.Type}, {"IsLate", type text}, {"Quantity", Int64.Type}, {"UnitPrice", type number}, {"GrossSales", type number}, {"DiscountRate", type number}, {"Discount", type number}, {"NetSales", type number}, {"Profit", type number}})
				in
				    #"Applied Types"

	partition 'Order Lines 2016' = m
		mode: import
		source =
				let
				    Source = Csv.Document(Web.Contents("https://raw.githubusercontent.com/owilliams84/powerbi-supply-chain/main/data/fact_order_line_2016.csv"), [Delimiter=",", Columns=20, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    #"Applied Types" = Table.TransformColumnTypes(#"Promoted Headers", {{"LineID", Int64.Type}, {"OrderID", Int64.Type}, {"Date", type date}, {"ShipDate", type date}, {"CustomerKey", Int64.Type}, {"ProductKey", Int64.Type}, {"GeoKey", Int64.Type}, {"ModeKey", Int64.Type}, {"OutcomeKey", Int64.Type}, {"PromisedDays", Int64.Type}, {"ActualDays", Int64.Type}, {"DaysLate", Int64.Type}, {"IsLate", type text}, {"Quantity", Int64.Type}, {"UnitPrice", type number}, {"GrossSales", type number}, {"DiscountRate", type number}, {"Discount", type number}, {"NetSales", type number}, {"Profit", type number}})
				in
