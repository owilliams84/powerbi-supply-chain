/// Measures behind the Calendar page: SVG cells, shade bands, cards, titles. Generated by
/// etl/milestone_calendar.py from the CALENDAR config.
table 'Calendar Metrics'
	lineageTag: d00753af-00a2-5f80-996e-9174efd4d03a

	/// 1 (lowest fifth of the cells on screen) to 5 (highest); 0 for an empty cell; blank
	/// where the grid has no such cell. Rank-based so one outlier cannot flatten the rest.
	measure 'Cal Band Day' =
			VAR Me = [Late Orders]
			VAR Live = FILTER(CALCULATETABLE(ADDCOLUMNS(VALUES('Date'[Date]), "@v", [Late Orders]), ALLSELECTED('Date')), [@v] > 0)
			VAR N = COUNTROWS(Live)
			VAR Below = COUNTROWS(FILTER(Live, [@v] < Me))
			RETURN
			    IF(
			        HASONEVALUE('Date'[Date]),
			        IF(Me > 0, IF(N <= 1, 5, MIN(5, INT(DIVIDE((Below + 0) * 5, N - 1)) + 1)), 0)
			    )
		formatString: 0
		lineageTag: e492e0e4-0c10-5efc-8f10-a2e7ae92d86d

	/// Cell background for the band. Bound to the matrix's background colour.
	measure 'Cal Colour Day' =
			VAR Band = [Cal Band Day]
			RETURN
			    IF(NOT ISBLANK(Band), SWITCH(Band, 1, "#E6E9F1", 2, "#BCC1D2", 3, "#7C8598", 4, "#3E4A66", 5, "#111F38", "#F4F6FA"))
		lineageTag: 75a16ddb-c0a2-5888-afcd-ea3d89056404

	/// One calendar cell at the Day grain, drawn at 112x88.
	measure 'Cal Cell Day' =
			VAR Band = [Cal Band Day]
			VAR V = [Late Orders]
			VAR Cnt = [Shipped Orders]
			VAR Fg = SWITCH(TRUE(), Band = 0, "#667284", Band >= 3, "#FFFFFF", "#0A0917")
			VAR Bg = [Cal Colour Day]
			VAR Svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='112' height='88' viewBox='0 0 112 88' font-family='Segoe UI, sans-serif'>"
			        & "<rect width='112' height='88' fill='" & Bg & "'/>"
			        & "<text x='8' y='17' font-size='11.5' font-weight='600' fill='" & Fg & "' opacity='0.85'>" & FORMAT(DAY(SELECTEDVALUE('Date'[Date])), "00") & "</text>"
			        & IF(
			            Band = 0,
			            "<text x='56' y='49' font-size='13' text-anchor='middle' fill='#667284'>&#8211;</text>",
			            "<text x='56' y='50' font-size='17' font-weight='700' text-anchor='middle' fill='" & Fg & "'>" & SWITCH(TRUE(), V >= 1000000, FORMAT(V / 1000000, "0.00") & "M", V >= 10000, FORMAT(V / 1000, "0.0") & "k", FORMAT(V, "#,0")) & "</text>"
			                & "<text x='104' y='80' font-size='10.5' text-anchor='end' fill='" & Fg & "' opacity='0.8'>" & FORMAT(Cnt, "#,0") & IF(Cnt = 1, " shipped", " shipped") & "</text>"
			        )
			        & "</svg>"
			RETURN
			    IF(NOT ISBLANK(Band), "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(Svg, "%", "%25"), "#", "%23"))
		dataCategory: ImageUrl
		lineageTag: 87ebe565-8db3-59da-bbf7-51af154f4acf

	/// 1 (lowest fifth of the cells on screen) to 5 (highest); 0 for an empty cell; blank
	/// where the grid has no such cell. Rank-based so one outlier cannot flatten the rest.
	measure 'Cal Band Month' =
			VAR Me = [Late Orders]
			VAR Live = FILTER(CALCULATETABLE(ADDCOLUMNS(VALUES('Date'[Cal Month No]), "@v", [Late Orders]), ALLSELECTED('Date')), [@v] > 0)
			VAR N = COUNTROWS(Live)
			VAR Below = COUNTROWS(FILTER(Live, [@v] < Me))
			RETURN
			    IF(
			        HASONEVALUE('Date'[Cal Month No]),
			        IF(Me > 0, IF(N <= 1, 5, MIN(5, INT(DIVIDE((Below + 0) * 5, N - 1)) + 1)), 0)
			    )
		formatString: 0
		lineageTag: 19e73e68-52f2-53e0-b099-8ee8f844d274

	/// Cell background for the band. Bound to the matrix's background colour.
	measure 'Cal Colour Month' =
			VAR Band = [Cal Band Month]
			RETURN
			    IF(NOT ISBLANK(Band), SWITCH(Band, 1, "#E6E9F1", 2, "#BCC1D2", 3, "#7C8598", 4, "#3E4A66", 5, "#111F38", "#F4F6FA"))
		lineageTag: 5de75101-ab59-578c-bcd5-9f68851fad3d

	/// One calendar cell at the Month grain, drawn at 266x138.
	measure 'Cal Cell Month' =
			VAR Band = [Cal Band Month]
			VAR V = [Late Orders]
			VAR Cnt = [Shipped Orders]
			VAR Fg = SWITCH(TRUE(), Band = 0, "#667284", Band >= 3, "#FFFFFF", "#0A0917")
			VAR Bg = [Cal Colour Month]
			VAR Svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='266' height='138' viewBox='0 0 266 138' font-family='Segoe UI, sans-serif'>"
			        & "<rect width='266' height='138' fill='" & Bg & "'/>"
			        & "<text x='8' y='17' font-size='11.5' font-weight='600' fill='" & Fg & "' opacity='0.85'>" & SELECTEDVALUE('Date'[Cal Month Short]) & "</text>"
			        & IF(
			            Band = 0,
			            "<text x='133' y='74' font-size='13' text-anchor='middle' fill='#667284'>&#8211;</text>",
			            "<text x='133' y='75' font-size='17' font-weight='700' text-anchor='middle' fill='" & Fg & "'>" & SWITCH(TRUE(), V >= 1000000, FORMAT(V / 1000000, "0.00") & "M", V >= 10000, FORMAT(V / 1000, "0.0") & "k", FORMAT(V, "#,0")) & "</text>"
			                & "<text x='258' y='130' font-size='10.5' text-anchor='end' fill='" & Fg & "' opacity='0.8'>" & FORMAT(Cnt, "#,0") & IF(Cnt = 1, " shipped", " shipped") & "</text>"
			        )
			        & "</svg>"
			RETURN
			    IF(NOT ISBLANK(Band), "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(Svg, "%", "%25"), "#", "%23"))
		dataCategory: ImageUrl
		lineageTag: daab7319-8577-57f2-9622-402e3fba31c0

	/// 1 (lowest fifth of the cells on screen) to 5 (highest); 0 for an empty cell; blank
