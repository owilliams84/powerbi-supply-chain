model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US

annotation PBI_QueryOrder = ["Date", "Product", "Customer", "Geography", "Shipping Mode", "Outcome", "Order Lines"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

ref table Date
ref table Product
ref table Customer
ref table Geography
ref table 'Shipping Mode'
ref table Outcome
ref table 'Order Lines'
ref table Metrics
