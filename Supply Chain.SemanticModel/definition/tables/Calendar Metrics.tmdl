		lineageTag: 9f1e236b-ff12-5d5b-8441-2f47be2cd4b7

	/// One calendar cell at the Quarter grain, drawn at 196x138.
	measure 'Cal Cell Quarter' =
			VAR Band = [Cal Band Quarter]
			VAR V = [Late Orders]
			VAR Cnt = [Shipped Orders]
			VAR Fg = SWITCH(TRUE(), Band = 0, "#667284", Band >= 3, "#FFFFFF", "#0A0917")
			VAR Bg = [Cal Colour Quarter]
			VAR Svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='196' height='138' viewBox='0 0 196 138' font-family='Segoe UI, sans-serif'>"
			        & "<rect width='196' height='138' fill='" & Bg & "'/>"
			        & "<text x='8' y='17' font-size='11.5' font-weight='600' fill='" & Fg & "' opacity='0.85'>" & SELECTEDVALUE('Date'[Cal Quarter Label]) & "</text>"
			        & IF(
			            Band = 0,
			            "<text x='98' y='74' font-size='13' text-anchor='middle' fill='#667284'>&#8211;</text>",
			            "<text x='98' y='75' font-size='17' font-weight='700' text-anchor='middle' fill='" & Fg & "'>" & SWITCH(TRUE(), V >= 1000000, FORMAT(V / 1000000, "0.00") & "M", V >= 10000, FORMAT(V / 1000, "0.0") & "k", FORMAT(V, "#,0")) & "</text>"
			                & "<text x='188' y='130' font-size='10.5' text-anchor='end' fill='" & Fg & "' opacity='0.8'>" & FORMAT(Cnt, "#,0") & IF(Cnt = 1, " shipped", " shipped") & "</text>"
			        )
			        & "</svg>"
			RETURN
			    IF(NOT ISBLANK(Band), "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(Svg, "%", "%25"), "#", "%23"))
		dataCategory: ImageUrl
		lineageTag: 4f4e235c-4c66-5fe3-9cbe-3418f6e5ca04

	/// 1 (lowest fifth of the cells on screen) to 5 (highest); 0 for an empty cell; blank
	/// where the grid has no such cell. Rank-based so one outlier cannot flatten the rest.
	measure 'Cal Band Year' =
			VAR Me = [Late Orders]
			VAR Live = FILTER(CALCULATETABLE(ADDCOLUMNS(VALUES('Date'[Cal Year]), "@v", [Late Orders]), ALLSELECTED('Date')), [@v] > 0)
			VAR N = COUNTROWS(Live)
			VAR Below = COUNTROWS(FILTER(Live, [@v] < Me))
			RETURN
			    IF(
			        HASONEVALUE('Date'[Cal Year]),
			        IF(Me > 0, IF(N <= 1, 5, MIN(5, INT(DIVIDE((Below + 0) * 5, N - 1)) + 1)), 0)
			    )
		formatString: 0
		lineageTag: 25c916ac-e7f8-515f-a34a-16969fd1b45f

	/// Cell background for the band. Bound to the matrix's background colour.
	measure 'Cal Colour Year' =
			VAR Band = [Cal Band Year]
			RETURN
			    IF(NOT ISBLANK(Band), SWITCH(Band, 1, "#E6E9F1", 2, "#BCC1D2", 3, "#7C8598", 4, "#3E4A66", 5, "#111F38", "#F4F6FA"))
		lineageTag: 42131122-1124-5848-af4c-f19cdd2281be

	/// One calendar cell at the Year grain, drawn at 196x230.
	measure 'Cal Cell Year' =
			VAR Band = [Cal Band Year]
			VAR V = [Late Orders]
			VAR Cnt = [Shipped Orders]
			VAR Fg = SWITCH(TRUE(), Band = 0, "#667284", Band >= 3, "#FFFFFF", "#0A0917")
			VAR Bg = [Cal Colour Year]
			VAR Svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='196' height='230' viewBox='0 0 196 230' font-family='Segoe UI, sans-serif'>"
			        & "<rect width='196' height='230' fill='" & Bg & "'/>"
			        & "<text x='8' y='17' font-size='11.5' font-weight='600' fill='" & Fg & "' opacity='0.85'>" & FORMAT(SELECTEDVALUE('Date'[Cal Year]), "0") & "</text>"
			        & IF(
			            Band = 0,
			            "<text x='98' y='120' font-size='13' text-anchor='middle' fill='#667284'>&#8211;</text>",
			            "<text x='98' y='121' font-size='17' font-weight='700' text-anchor='middle' fill='" & Fg & "'>" & SWITCH(TRUE(), V >= 1000000, FORMAT(V / 1000000, "0.00") & "M", V >= 10000, FORMAT(V / 1000, "0.0") & "k", FORMAT(V, "#,0")) & "</text>"
			                & "<text x='188' y='222' font-size='10.5' text-anchor='end' fill='" & Fg & "' opacity='0.8'>" & FORMAT(Cnt, "#,0") & IF(Cnt = 1, " shipped", " shipped") & "</text>"
			        )
			        & "</svg>"
			RETURN
			    IF(NOT ISBLANK(Band), "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(Svg, "%", "%25"), "#", "%23"))
		dataCategory: ImageUrl
		lineageTag: 0242ea35-3fd1-5dca-adf5-d940cee50a49

	/// Days on which late orders is above zero.
	measure 'Cal Active Days' = COUNTROWS(FILTER(VALUES('Date'[Date]), [Late Orders] > 0))
		formatString: #,0
		lineageTag: ee552376-324f-551d-b124-034e41f100ed

	/// Late orders divided by the days that had any.
	measure 'Cal Avg per Active Day' = DIVIDE([Late Orders], [Cal Active Days])
		formatString: #,0.0
		lineageTag: 5bd18c78-8354-5d0f-a9bc-fa692fae38ef

	/// Weekends in slate on the weekday bars.
	measure 'Cal Weekday Colour' = IF(SELECTEDVALUE('Date'[Cal Weekday No]) >= 6, "#7C8598", "#111F38")
		lineageTag: 77b21c4f-9dae-596a-8d40-9130f70ae6db

	measure 'Cal Month Label' = SELECTEDVALUE('Date'[Cal Month], "All months") & " " & SELECTEDVALUE('Date'[Cal Year], "all years")
		lineageTag: 39f8fc54-6377-509c-aa31-e1b8c2f3b173

	/// The same days of the same month a year earlier.
	measure 'Cal Value Month PY' =
			VAR Y = SELECTEDVALUE('Date'[Cal Year])
			VAR Mn = SELECTEDVALUE('Date'[Cal Month No])
			VAR Cap = EDATE(MAX('Date'[Date]), -12)
			RETURN
			    IF(NOT ISBLANK(Y) && NOT ISBLANK(Mn), CALCULATE([Late Orders], REMOVEFILTERS('Date'), 'Date'[Cal Year] = Y - 1, 'Date'[Cal Month No] = Mn, 'Date'[Date] <= Cap))
		lineageTag: 73305fb8-b023-5ff1-bf10-16725628c0fa

	/// The year before, up to the same day of the year - so a part year is compared with
	/// the same part of the year before.
	measure 'Cal Value Year PY' =
			VAR Y = SELECTEDVALUE('Date'[Cal Year])
			VAR Cap = EDATE(MAX('Date'[Date]), -12)
			RETURN
			    IF(NOT ISBLANK(Y), CALCULATE([Late Orders], REMOVEFILTERS('Date'), 'Date'[Cal Year] = Y - 1, 'Date'[Date] <= Cap))
		lineageTag: 0c584f4d-bce6-5380-b45d-741c86614403

	/// False where the date table covers only part of the year on screen.
	measure 'Cal Year Is Whole' =
			VAR Y = SELECTEDVALUE('Date'[Cal Year])
			RETURN
			    CALCULATE(COUNTROWS('Date'), REMOVEFILTERS('Date'), 'Date'[Cal Year] = Y) >= 365
		lineageTag: dcdae2cf-1e1c-574c-ac3a-b1fcd6856ada

	measure 'Card Cal Total Day' =
			VAR Cur = [Late Orders]
			VAR Prev = [Cal Value Month PY]
			VAR Change = DIVIDE(Cur - Prev, Prev)
			VAR NoteText =
			    IF(
			        Prev > 0,
			        "<tspan font-weight='700' fill='" & IF(Change >= 0, "#B3261E", "#1E7A4C") & "'>" & IF(Change >= 0, "&#9650; ", "&#9660; ") & FORMAT(ABS(Change), "0.0%") & "</tspan>" & " on " & SELECTEDVALUE('Date'[Cal Month Short]) & " " & (SELECTEDVALUE('Date'[Cal Year]) - 1) & " (" & SWITCH(TRUE(), Prev >= 1000000, FORMAT(Prev / 1000000, "0.00") & "M", Prev >= 10000, FORMAT(Prev / 1000, "0.0") & "k", FORMAT(Prev, "#,0")) & ")",
			        "Nothing a year earlier to compare with"
			    )
			VAR Svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='476' height='152' viewBox='0 0 476 152' font-family='Segoe UI, sans-serif'>"
			    & "<rect x='0.5' y='0.5' width='475' height='151' rx='4' fill='#FFFFFF' stroke='#E3E7EF'/><rect width='3' height='152' fill='#C9A227'/>"
			    & "<text x='16' y='24' font-size='11' font-weight='700' fill='#667284' letter-spacing='0.4'>" & "LATE ORDERS IN VIEW" & "</text>"
			    & "<text x='16' y='58' font-size='28' font-weight='700' fill='#0A0917'>" & SWITCH(TRUE(), Cur >= 1000000, FORMAT(Cur / 1000000, "0.00") & "M", Cur >= 10000, FORMAT(Cur / 1000, "0.0") & "k", FORMAT(Cur, "#,0")) & "</text>"
			    & "<text x='16' y='77' font-size='11.5' fill='#667284'>" & NoteText & "</text>"
			    & "<line x1='16' y1='90' x2='460' y2='90' stroke='#E3E7EF'/>"
			    & "<text x='16' y='114' font-size='11.5' fill='#4A5768'>" & "Shipped" & "</text><text x='460' y='114' font-size='11.5' font-weight='600' text-anchor='end' fill='#0A0917'>" & FORMAT([Shipped Orders], "#,0") & "</text>"
			    & "<text x='16' y='134' font-size='11.5' fill='#4A5768'>" & "Average per active day" & "</text><text x='460' y='134' font-size='11.5' font-weight='600' text-anchor='end' fill='#0A0917'>" & SWITCH(TRUE(), [Cal Avg per Active Day] >= 1000000, FORMAT([Cal Avg per Active Day] / 1000000, "0.00") & "M", [Cal Avg per Active Day] >= 10000, FORMAT([Cal Avg per Active Day] / 1000, "0.0") & "k", FORMAT([Cal Avg per Active Day], "#,0")) & "</text>"
			    & "</svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(Svg, "%", "%25"), "#", "%23")
		dataCategory: ImageUrl
		lineageTag: 98bfeed3-7839-5d46-966f-9cff86248f7f

	measure 'Card Cal Total Month' =
			CALCULATE(
			VAR Cur = [Late Orders]
			VAR Prev = [Cal Value Year PY]
			VAR Change = DIVIDE(Cur - Prev, Prev)
			VAR NoteText =
			    IF(
			        Prev > 0,
			        "<tspan font-weight='700' fill='" & IF(Change >= 0, "#B3261E", "#1E7A4C") & "'>" & IF(Change >= 0, "&#9650; ", "&#9660; ") & FORMAT(ABS(Change), "0.0%") & "</tspan>" & " on " & IF([Cal Year Is Whole], "", "the same period of ") & (SELECTEDVALUE('Date'[Cal Year]) - 1) & " (" & SWITCH(TRUE(), Prev >= 1000000, FORMAT(Prev / 1000000, "0.00") & "M", Prev >= 10000, FORMAT(Prev / 1000, "0.0") & "k", FORMAT(Prev, "#,0")) & ")",
			        "Nothing a year earlier to compare with"
			    )
			VAR Svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='476' height='152' viewBox='0 0 476 152' font-family='Segoe UI, sans-serif'>"
			    & "<rect x='0.5' y='0.5' width='475' height='151' rx='4' fill='#FFFFFF' stroke='#E3E7EF'/><rect width='3' height='152' fill='#C9A227'/>"
			    & "<text x='16' y='24' font-size='11' font-weight='700' fill='#667284' letter-spacing='0.4'>" & "LATE ORDERS IN VIEW" & "</text>"
			    & "<text x='16' y='58' font-size='28' font-weight='700' fill='#0A0917'>" & SWITCH(TRUE(), Cur >= 1000000, FORMAT(Cur / 1000000, "0.00") & "M", Cur >= 10000, FORMAT(Cur / 1000, "0.0") & "k", FORMAT(Cur, "#,0")) & "</text>"
			    & "<text x='16' y='77' font-size='11.5' fill='#667284'>" & NoteText & "</text>"
			    & "<line x1='16' y1='90' x2='460' y2='90' stroke='#E3E7EF'/>"
			    & "<text x='16' y='114' font-size='11.5' fill='#4A5768'>" & "Shipped" & "</text><text x='460' y='114' font-size='11.5' font-weight='600' text-anchor='end' fill='#0A0917'>" & FORMAT([Shipped Orders], "#,0") & "</text>"
			    & "<text x='16' y='134' font-size='11.5' fill='#4A5768'>" & "Average per active day" & "</text><text x='460' y='134' font-size='11.5' font-weight='600' text-anchor='end' fill='#0A0917'>" & SWITCH(TRUE(), [Cal Avg per Active Day] >= 1000000, FORMAT([Cal Avg per Active Day] / 1000000, "0.00") & "M", [Cal Avg per Active Day] >= 10000, FORMAT([Cal Avg per Active Day] / 1000, "0.0") & "k", FORMAT([Cal Avg per Active Day], "#,0")) & "</text>"
			    & "</svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(Svg, "%", "%25"), "#", "%23"), REMOVEFILTERS('Date'[Cal Month]))
		dataCategory: ImageUrl
		lineageTag: 2ce0fd21-c205-509d-bcb4-53218bc6c234

	measure 'Card Cal Total All' =
			CALCULATE(
			VAR Cur = [Late Orders]
			VAR YearCount = COUNTROWS(FILTER(VALUES('Date'[Cal Year]), [Late Orders] > 0))
			VAR Svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='476' height='152' viewBox='0 0 476 152' font-family='Segoe UI, sans-serif'>"
			    & "<rect x='0.5' y='0.5' width='475' height='151' rx='4' fill='#FFFFFF' stroke='#E3E7EF'/><rect width='3' height='152' fill='#C9A227'/>"
			    & "<text x='16' y='24' font-size='11' font-weight='700' fill='#667284' letter-spacing='0.4'>" & "LATE ORDERS IN VIEW" & "</text>"
			    & "<text x='16' y='58' font-size='28' font-weight='700' fill='#0A0917'>" & SWITCH(TRUE(), Cur >= 1000000, FORMAT(Cur / 1000000, "0.00") & "M", Cur >= 10000, FORMAT(Cur / 1000, "0.0") & "k", FORMAT(Cur, "#,0")) & "</text>"
			    & "<text x='16' y='77' font-size='11.5' fill='#667284'>" & "All " & YearCount & " years - nothing earlier to compare with" & "</text>"
			    & "<line x1='16' y1='90' x2='460' y2='90' stroke='#E3E7EF'/>"
			    & "<text x='16' y='114' font-size='11.5' fill='#4A5768'>" & "Shipped" & "</text><text x='460' y='114' font-size='11.5' font-weight='600' text-anchor='end' fill='#0A0917'>" & FORMAT([Shipped Orders], "#,0") & "</text>"
			    & "<text x='16' y='134' font-size='11.5' fill='#4A5768'>" & "Average per active day" & "</text><text x='460' y='134' font-size='11.5' font-weight='600' text-anchor='end' fill='#0A0917'>" & SWITCH(TRUE(), [Cal Avg per Active Day] >= 1000000, FORMAT([Cal Avg per Active Day] / 1000000, "0.00") & "M", [Cal Avg per Active Day] >= 10000, FORMAT([Cal Avg per Active Day] / 1000, "0.0") & "k", FORMAT([Cal Avg per Active Day], "#,0")) & "</text>"
			    & "</svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(Svg, "%", "%25"), "#", "%23"), REMOVEFILTERS('Date'[Cal Month], 'Date'[Cal Year]))
		dataCategory: ImageUrl
		lineageTag: 64824c96-2358-54c5-85a9-18efa8a4fdea

	measure 'Card Cal Peak Day' =
			VAR Pool = ADDCOLUMNS(VALUES('Date'[Date]), "@v", [Late Orders])
			VAR Best = MAXX(Pool, [@v])
			VAR BestDate = MINX(FILTER(Pool, [@v] = Best), 'Date'[Date])
			VAR DaysAll = COUNTROWS(Pool)
			VAR Quiet = DaysAll - [Cal Active Days]
			VAR Svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='476' height='152' viewBox='0 0 476 152' font-family='Segoe UI, sans-serif'>"
			    & "<rect x='0.5' y='0.5' width='475' height='151' rx='4' fill='#FFFFFF' stroke='#E3E7EF'/><rect width='3' height='152' fill='#C9A227'/>"
			    & "<text x='16' y='24' font-size='11' font-weight='700' fill='#667284' letter-spacing='0.4'>" & "WORST DAY" & "</text>"
			    & "<text x='16' y='58' font-size='28' font-weight='700' fill='#0A0917'>" & SWITCH(TRUE(), Best >= 1000000, FORMAT(Best / 1000000, "0.00") & "M", Best >= 10000, FORMAT(Best / 1000, "0.0") & "k", FORMAT(Best, "#,0")) & "</text>"
			    & "<text x='16' y='77' font-size='11.5' fill='#667284'>" & FORMAT(BestDate, "ddd d mmmm yyyy") & "</text>"
			    & "<line x1='16' y1='90' x2='460' y2='90' stroke='#E3E7EF'/>"
			    & "<text x='16' y='111' font-size='11.5' fill='#4A5768'>" & "Average per active day" & "</text><text x='460' y='111' font-size='11.5' font-weight='600' text-anchor='end' fill='#0A0917'>" & SWITCH(TRUE(), [Cal Avg per Active Day] >= 1000000, FORMAT([Cal Avg per Active Day] / 1000000, "0.00") & "M", [Cal Avg per Active Day] >= 10000, FORMAT([Cal Avg per Active Day] / 1000, "0.0") & "k", FORMAT([Cal Avg per Active Day], "#,0")) & "</text>"
			    & "<text x='16' y='128' font-size='11.5' fill='#4A5768'>" & "Days with no late orders" & "</text><text x='460' y='128' font-size='11.5' font-weight='600' text-anchor='end' fill='#0A0917'>" & Quiet & " of " & DaysAll & "</text>"
			    & "<text x='16' y='145' font-size='11.5' fill='#4A5768'>" & "Worst day&apos;s share of the month" & "</text><text x='460' y='145' font-size='11.5' font-weight='600' text-anchor='end' fill='#0A0917'>" & FORMAT(DIVIDE(Best, [Late Orders]), "0.0%") & "</text>"
			    & "</svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(Svg, "%", "%25"), "#", "%23")
		dataCategory: ImageUrl
		lineageTag: ea2ce096-56c5-54df-af7d-03bfaae1b817

	measure 'Card Cal Peak Month' =
			CALCULATE(
			VAR Pool = FILTER(ADDCOLUMNS(SUMMARIZE('Date', 'Date'[Cal Month No], 'Date'[Cal Month], 'Date'[Cal Month Short]), "@v", [Late Orders]), [@v] > 0)
			VAR Best = MAXX(Pool, [@v])
			VAR Worst = MINX(Pool, [@v])
			VAR BestName = MINX(FILTER(Pool, [@v] = Best), 'Date'[Cal Month])
			VAR WorstName = MINX(FILTER(Pool, [@v] = Worst), 'Date'[Cal Month Short])
			VAR Svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='476' height='152' viewBox='0 0 476 152' font-family='Segoe UI, sans-serif'>"
			    & "<rect x='0.5' y='0.5' width='475' height='151' rx='4' fill='#FFFFFF' stroke='#E3E7EF'/><rect width='3' height='152' fill='#C9A227'/>"
			    & "<text x='16' y='24' font-size='11' font-weight='700' fill='#667284' letter-spacing='0.4'>" & "WORST MONTH" & "</text>"
			    & "<text x='16' y='58' font-size='28' font-weight='700' fill='#0A0917'>" & SWITCH(TRUE(), Best >= 1000000, FORMAT(Best / 1000000, "0.00") & "M", Best >= 10000, FORMAT(Best / 1000, "0.0") & "k", FORMAT(Best, "#,0")) & "</text>"
			    & "<text x='16' y='77' font-size='11.5' fill='#667284'>" & BestName & " " & SELECTEDVALUE('Date'[Cal Year]) & "</text>"
			    & "<line x1='16' y1='90' x2='460' y2='90' stroke='#E3E7EF'/>"
			    & "<text x='16' y='111' font-size='11.5' fill='#4A5768'>" & "Average per month" & "</text><text x='460' y='111' font-size='11.5' font-weight='600' text-anchor='end' fill='#0A0917'>" & SWITCH(TRUE(), DIVIDE([Late Orders], COUNTROWS(Pool)) >= 1000000, FORMAT(DIVIDE([Late Orders], COUNTROWS(Pool)) / 1000000, "0.00") & "M", DIVIDE([Late Orders], COUNTROWS(Pool)) >= 10000, FORMAT(DIVIDE([Late Orders], COUNTROWS(Pool)) / 1000, "0.0") & "k", FORMAT(DIVIDE([Late Orders], COUNTROWS(Pool)), "#,0")) & "</text>"
			    & "<text x='16' y='128' font-size='11.5' fill='#4A5768'>" & "Smallest month" & "</text><text x='460' y='128' font-size='11.5' font-weight='600' text-anchor='end' fill='#0A0917'>" & WorstName & " &#183; " & SWITCH(TRUE(), Worst >= 1000000, FORMAT(Worst / 1000000, "0.00") & "M", Worst >= 10000, FORMAT(Worst / 1000, "0.0") & "k", FORMAT(Worst, "#,0")) & "</text>"
			    & "<text x='16' y='145' font-size='11.5' fill='#4A5768'>" & "Worst month&apos;s share of the year" & IF([Cal Year Is Whole], "", " to date") & "</text><text x='460' y='145' font-size='11.5' font-weight='600' text-anchor='end' fill='#0A0917'>" & FORMAT(DIVIDE(Best, [Late Orders]), "0.0%") & "</text>"
			    & "</svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(Svg, "%", "%25"), "#", "%23"), REMOVEFILTERS('Date'[Cal Month]))
		dataCategory: ImageUrl
		lineageTag: 23f1551f-baae-5442-bb73-c646d17a6eaf

	measure 'Card Cal Peak Quarter' =
			CALCULATE(
			VAR Pool = FILTER(ADDCOLUMNS(SUMMARIZE('Date', 'Date'[Cal Quarter Key], 'Date'[Cal Quarter Label]), "@v", [Late Orders]), [@v] > 0)
			VAR Best = MAXX(Pool, [@v])
			VAR BestName = MINX(FILTER(Pool, [@v] = Best), 'Date'[Cal Quarter Label])
			VAR AllValue = [Late Orders]
			VAR WholeYears = FILTER(VALUES('Date'[Cal Year]), VAR Yr = 'Date'[Cal Year] RETURN CALCULATE(COUNTROWS('Date'), REMOVEFILTERS('Date'), 'Date'[Cal Year] = Yr) >= 365)
			VAR PartYears = COUNTROWS(FILTER(VALUES('Date'[Cal Year]), [Late Orders] > 0)) - COUNTROWS(FILTER(WholeYears, [Late Orders] > 0))
			VAR WholeValue = CALCULATE([Late Orders], WholeYears)
			VAR ShareNote = IF(PartYears > 0, " share, whole years", " share of the total")
			VAR Svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='476' height='152' viewBox='0 0 476 152' font-family='Segoe UI, sans-serif'>"
			    & "<rect x='0.5' y='0.5' width='475' height='151' rx='4' fill='#FFFFFF' stroke='#E3E7EF'/><rect width='3' height='152' fill='#C9A227'/>"
			    & "<text x='16' y='24' font-size='11' font-weight='700' fill='#667284' letter-spacing='0.4'>" & "WORST QUARTER" & "</text>"
			    & "<text x='16' y='58' font-size='28' font-weight='700' fill='#0A0917'>" & SWITCH(TRUE(), Best >= 1000000, FORMAT(Best / 1000000, "0.00") & "M", Best >= 10000, FORMAT(Best / 1000, "0.0") & "k", FORMAT(Best, "#,0")) & "</text>"
			    & "<text x='16' y='77' font-size='11.5' fill='#667284'>" & BestName & "</text>"
			    & "<line x1='16' y1='90' x2='460' y2='90' stroke='#E3E7EF'/>"
			    & "<text x='16' y='111' font-size='11.5' fill='#4A5768'>" & "Average per quarter" & "</text><text x='460' y='111' font-size='11.5' font-weight='600' text-anchor='end' fill='#0A0917'>" & SWITCH(TRUE(), DIVIDE(AllValue, COUNTROWS(Pool)) >= 1000000, FORMAT(DIVIDE(AllValue, COUNTROWS(Pool)) / 1000000, "0.00") & "M", DIVIDE(AllValue, COUNTROWS(Pool)) >= 10000, FORMAT(DIVIDE(AllValue, COUNTROWS(Pool)) / 1000, "0.0") & "k", FORMAT(DIVIDE(AllValue, COUNTROWS(Pool)), "#,0")) & "</text>"
			    & "<text x='16' y='128' font-size='11.5' fill='#4A5768'>" & "Q4" & ShareNote & "</text><text x='460' y='128' font-size='11.5' font-weight='600' text-anchor='end' fill='#0A0917'>" & FORMAT(DIVIDE(CALCULATE([Late Orders], 'Date'[Cal Quarter] = "Q4", WholeYears), WholeValue), "0.0%") & "</text>"
			    & "<text x='16' y='145' font-size='11.5' fill='#4A5768'>" & "Q1" & ShareNote & "</text><text x='460' y='145' font-size='11.5' font-weight='600' text-anchor='end' fill='#0A0917'>" & FORMAT(DIVIDE(CALCULATE([Late Orders], 'Date'[Cal Quarter] = "Q1", WholeYears), WholeValue), "0.0%") & "</text>"
			    & "</svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(Svg, "%", "%25"), "#", "%23"), REMOVEFILTERS('Date'[Cal Month], 'Date'[Cal Year]))
		dataCategory: ImageUrl
		lineageTag: 08202b05-4429-56ba-a994-f4e18e2be456

	measure 'Card Cal Peak Year' =
			CALCULATE(
			VAR AllYears = FILTER(ADDCOLUMNS(VALUES('Date'[Cal Year]), "@v", [Late Orders]), [@v] > 0)
			VAR Pool = FILTER(AllYears, VAR Yr = 'Date'[Cal Year] RETURN CALCULATE(COUNTROWS('Date'), REMOVEFILTERS('Date'), 'Date'[Cal Year] = Yr) >= 365)
			VAR PartYears = COUNTROWS(AllYears) - COUNTROWS(Pool)
			VAR YearLast = MAXX(Pool, 'Date'[Cal Year])
			VAR YearFirst = MINX(Pool, 'Date'[Cal Year])
			VAR ValueLast = MAXX(FILTER(Pool, 'Date'[Cal Year] = YearLast), [@v])
			VAR ValueBefore = MAXX(FILTER(Pool, 'Date'[Cal Year] = YearLast - 1), [@v])
			VAR ValueFirst = MAXX(FILTER(Pool, 'Date'[Cal Year] = YearFirst), [@v])
			VAR ValueSecond = MAXX(FILTER(Pool, 'Date'[Cal Year] = YearFirst + 1), [@v])
			VAR Best = MAXX(Pool, [@v])
			VAR BestYear = MINX(FILTER(Pool, [@v] = Best), 'Date'[Cal Year])
			VAR ChangeLast = DIVIDE(ValueLast - ValueBefore, ValueBefore)
			VAR ChangeSecond = DIVIDE(ValueSecond - ValueFirst, ValueFirst)
			VAR Svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='476' height='152' viewBox='0 0 476 152' font-family='Segoe UI, sans-serif'>"
			    & "<rect x='0.5' y='0.5' width='475' height='151' rx='4' fill='#FFFFFF' stroke='#E3E7EF'/><rect width='3' height='152' fill='#C9A227'/>"
			    & "<text x='16' y='24' font-size='11' font-weight='700' fill='#667284' letter-spacing='0.4'>" & "WORST YEAR" & "</text>"
			    & "<text x='16' y='58' font-size='28' font-weight='700' fill='#0A0917'>" & SWITCH(TRUE(), Best >= 1000000, FORMAT(Best / 1000000, "0.00") & "M", Best >= 10000, FORMAT(Best / 1000, "0.0") & "k", FORMAT(Best, "#,0")) & "</text>"
			    & "<text x='16' y='77' font-size='11.5' fill='#667284'>" & FORMAT(BestYear, "0") & "</text>"
			    & "<line x1='16' y1='90' x2='460' y2='90' stroke='#E3E7EF'/>"
			    & "<text x='16' y='111' font-size='11.5' fill='#4A5768'>" & IF(PartYears > 0, "Average per whole year", "Average per year") & "</text><text x='460' y='111' font-size='11.5' font-weight='600' text-anchor='end' fill='#0A0917'>" & SWITCH(TRUE(), AVERAGEX(Pool, [@v]) >= 1000000, FORMAT(AVERAGEX(Pool, [@v]) / 1000000, "0.00") & "M", AVERAGEX(Pool, [@v]) >= 10000, FORMAT(AVERAGEX(Pool, [@v]) / 1000, "0.0") & "k", FORMAT(AVERAGEX(Pool, [@v]), "#,0")) & "</text>"
			    & "<text x='16' y='128' font-size='11.5' fill='#4A5768'>" & YearLast & " on " & (YearLast - 1) & "</text><text x='460' y='128' font-size='11.5' font-weight='600' text-anchor='end' fill='#0A0917'>" & "<tspan font-weight='700' fill='" & IF(ChangeLast >= 0, "#B3261E", "#1E7A4C") & "'>" & IF(ChangeLast >= 0, "&#9650; ", "&#9660; ") & FORMAT(ABS(ChangeLast), "0.0%") & "</tspan>" & "</text>"
			    & "<text x='16' y='145' font-size='11.5' fill='#4A5768'>" & (YearFirst + 1) & " on " & YearFirst & "</text><text x='460' y='145' font-size='11.5' font-weight='600' text-anchor='end' fill='#0A0917'>" & "<tspan font-weight='700' fill='" & IF(ChangeSecond >= 0, "#B3261E", "#1E7A4C") & "'>" & IF(ChangeSecond >= 0, "&#9650; ", "&#9660; ") & FORMAT(ABS(ChangeSecond), "0.0%") & "</tspan>" & "</text>"
			    & "</svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(Svg, "%", "%25"), "#", "%23"), REMOVEFILTERS('Date'[Cal Month], 'Date'[Cal Year]))
		dataCategory: ImageUrl
		lineageTag: c5340ac5-bd85-5b16-9f38-0249a56a6e88

	measure 'Title Cal Day' =
			VAR Cur = [Late Orders]
			RETURN
			    [Cal Month Label] & ": " & SWITCH(TRUE(), Cur >= 1000000, FORMAT(Cur / 1000000, "0.00") & "M", Cur >= 10000, FORMAT(Cur / 1000, "0.0") & "k", FORMAT(Cur, "#,0")) & " late orders" & " across " & [Cal Active Days] & " active days" 
		lineageTag: 9a061a7b-83e1-5f24-97b4-49dd23ca7354

	measure 'Title Cal Month' =
			CALCULATE(
			VAR Pool = ADDCOLUMNS(SUMMARIZE('Date', 'Date'[Cal Month No], 'Date'[Cal Month]), "@v", [Late Orders])
			VAR Best = MAXX(Pool, [@v])
			VAR Cur = [Late Orders]
			RETURN
			    SELECTEDVALUE('Date'[Cal Year]) & ": " & SWITCH(TRUE(), Cur >= 1000000, FORMAT(Cur / 1000000, "0.00") & "M", Cur >= 10000, FORMAT(Cur / 1000, "0.0") & "k", FORMAT(Cur, "#,0")) & " late orders" & ", and " & MINX(FILTER(Pool, [@v] = Best), 'Date'[Cal Month]) & " was the worst month" , REMOVEFILTERS('Date'[Cal Month]))
		lineageTag: e81efc00-78a0-5219-b176-2427a146ab45

	measure 'Title Cal Quarter' =
			CALCULATE(
			VAR WholeYears = FILTER(VALUES('Date'[Cal Year]), VAR Yr = 'Date'[Cal Year] RETURN CALCULATE(COUNTROWS('Date'), REMOVEFILTERS('Date'), 'Date'[Cal Year] = Yr) >= 365)
			VAR PartYears = COUNTROWS(FILTER(VALUES('Date'[Cal Year]), [Late Orders] > 0)) - COUNTROWS(FILTER(WholeYears, [Late Orders] > 0))
			VAR WholeValue = CALCULATE([Late Orders], WholeYears)
			VAR Pool = ADDCOLUMNS(VALUES('Date'[Cal Quarter]), "@v", CALCULATE([Late Orders], WholeYears))
			VAR Best = MAXX(Pool, [@v])
			RETURN
			    MINX(FILTER(Pool, [@v] = Best), 'Date'[Cal Quarter]) & " carries " & FORMAT(DIVIDE(Best, WholeValue), "0%") & " of all late orders, more than any other quarter"
			        & IF(PartYears > 0, " (whole years only)", "") , REMOVEFILTERS('Date'[Cal Month], 'Date'[Cal Year]))
		lineageTag: b5375afa-1778-5aad-af46-4319ba8402ca

	measure 'Title Cal Year' =
			CALCULATE(
			VAR AllYears = FILTER(ADDCOLUMNS(VALUES('Date'[Cal Year]), "@v", [Late Orders]), [@v] > 0)
			VAR Pool = FILTER(AllYears, VAR Yr = 'Date'[Cal Year] RETURN CALCULATE(COUNTROWS('Date'), REMOVEFILTERS('Date'), 'Date'[Cal Year] = Yr) >= 365)
			VAR PartYears = COUNTROWS(AllYears) - COUNTROWS(Pool)
			VAR YearLast = MAXX(Pool, 'Date'[Cal Year])
			VAR YearFirst = MINX(Pool, 'Date'[Cal Year])
			VAR ValueLast = MAXX(FILTER(Pool, 'Date'[Cal Year] = YearLast), [@v])
			VAR ValueBefore = MAXX(FILTER(Pool, 'Date'[Cal Year] = YearLast - 1), [@v])
			VAR ValueFirst = MAXX(FILTER(Pool, 'Date'[Cal Year] = YearFirst), [@v])
			VAR ValueSecond = MAXX(FILTER(Pool, 'Date'[Cal Year] = YearFirst + 1), [@v])
			VAR Change = DIVIDE(ValueLast - ValueFirst, ValueFirst)
			RETURN
			    YearLast & " closed at " & SWITCH(TRUE(), ValueLast >= 1000000, FORMAT(ValueLast / 1000000, "0.00") & "M", ValueLast >= 10000, FORMAT(ValueLast / 1000, "0.0") & "k", FORMAT(ValueLast, "#,0")) & " late orders" & ", " & IF(Change >= 0, "up ", "down ") & FORMAT(ABS(Change), "0.0%") & " on " & YearFirst
			        & IF(PartYears > 0, " (whole years only)", "") , REMOVEFILTERS('Date'[Cal Month], 'Date'[Cal Year]))
		lineageTag: 5cf15a6e-4001-5cbd-9bd7-724b501298a6

	measure 'Title Cal Weekday' =
			VAR Pool = FILTER(ADDCOLUMNS(SUMMARIZE('Date', 'Date'[Cal Weekday No], 'Date'[Cal Day Name]), "@v", [Cal Avg per Active Day]), [@v] > 0)
			VAR Best = MAXX(Pool, [@v])
			RETURN
			    IF(ISEMPTY(Pool), "Nothing in this period", MINX(FILTER(Pool, [@v] = Best), 'Date'[Cal Day Name]) & "s run highest per active day")
		lineageTag: 7f63d5f7-db16-5103-9593-9d0359b5d41a

	measure 'Standfirst Cal Day' =
			VAR Cur = [Late Orders]
			VAR Prev = [Cal Value Month PY]
			VAR Change = DIVIDE(Cur - Prev, Prev)
			VAR Pool = ADDCOLUMNS(VALUES('Date'[Date]), "@v", [Late Orders])
			VAR Best = MAXX(Pool, [@v])
			VAR BestDay = DAY(MINX(FILTER(Pool, [@v] = Best), 'Date'[Date]))
			VAR Sfx = SWITCH(TRUE(), MOD(BestDay, 100) IN {11, 12, 13}, "th", MOD(BestDay, 10) = 1, "st", MOD(BestDay, 10) = 2, "nd", MOD(BestDay, 10) = 3, "rd", "th")
			VAR DaysAll = COUNTROWS(Pool)
			RETURN
			    [Cal Month Label] & " recorded " & SWITCH(TRUE(), Cur >= 1000000, FORMAT(Cur / 1000000, "0.00") & "M", Cur >= 10000, FORMAT(Cur / 1000, "0.0") & "k", FORMAT(Cur, "#,0")) & " late orders" & " from " & FORMAT([Shipped Orders], "#,0") & " shipped"
			        & IF(Prev > 0, ", " & IF(Change >= 0, "up ", "down ") & FORMAT(ABS(Change), "0.0%") & " on the same month a year earlier", "")
			        & ". The worst day was the " & BestDay & Sfx & " at " & SWITCH(TRUE(), Best >= 1000000, FORMAT(Best / 1000000, "0.00") & "M", Best >= 10000, FORMAT(Best / 1000, "0.0") & "k", FORMAT(Best, "#,0")) & "; "
			        & IF(DaysAll = [Cal Active Days], "none of the " & DaysAll, (DaysAll - [Cal Active Days]) & " of " & DaysAll)
			        & " days had no late orders." 
		lineageTag: d4eccc44-9a02-5c51-8c9f-26c53800f4c8

	measure 'Standfirst Cal Month' =
			CALCULATE(
			VAR Cur = [Late Orders]
			VAR Prev = [Cal Value Year PY]
			VAR Change = DIVIDE(Cur - Prev, Prev)
			VAR Pool = ADDCOLUMNS(SUMMARIZE('Date', 'Date'[Cal Month No], 'Date'[Cal Month]), "@v", [Late Orders])
			VAR Best = MAXX(Pool, [@v])
			RETURN
			    SELECTEDVALUE('Date'[Cal Year]) & " recorded " & SWITCH(TRUE(), Cur >= 1000000, FORMAT(Cur / 1000000, "0.00") & "M", Cur >= 10000, FORMAT(Cur / 1000, "0.0") & "k", FORMAT(Cur, "#,0")) & " late orders" & " from " & FORMAT([Shipped Orders], "#,0") & " shipped"
			        & IF(Prev > 0, ", " & IF(Change >= 0, "up ", "down ") & FORMAT(ABS(Change), "0.0%") & " on " & IF([Cal Year Is Whole], "", "the same period of ") & (SELECTEDVALUE('Date'[Cal Year]) - 1), "")
			        & ". " & MINX(FILTER(Pool, [@v] = Best), 'Date'[Cal Month]) & " alone was " & FORMAT(DIVIDE(Best, Cur), "0.0%")
			        & " of the year" & IF([Cal Year Is Whole], "", " to date") & ". Switch to Day to open a month." , REMOVEFILTERS('Date'[Cal Month]))
		lineageTag: 956b6336-0c88-522a-a18d-ab9983b95eae

	measure 'Standfirst Cal Quarter' =
			CALCULATE(
			VAR Cur = [Late Orders]
			VAR Pool = FILTER(ADDCOLUMNS(VALUES('Date'[Cal Year]), "@v", [Late Orders]), [@v] > 0)
			RETURN
			    MINX(Pool, 'Date'[Cal Year]) & " to " & MAXX(Pool, 'Date'[Cal Year]) & " recorded " & SWITCH(TRUE(), Cur >= 1000000, FORMAT(Cur / 1000000, "0.00") & "M", Cur >= 10000, FORMAT(Cur / 1000, "0.0") & "k", FORMAT(Cur, "#,0")) & " late orders" & " from " & FORMAT([Shipped Orders], "#,0") & " shipped"
			        & ". Read across a row for the shape of a year, down a column for the same quarter year on year." , REMOVEFILTERS('Date'[Cal Month], 'Date'[Cal Year]))
		lineageTag: 48b1c1db-ce4f-5083-8dae-51642bcdaedc

	measure 'Standfirst Cal Year' =
			CALCULATE(
			VAR Cur = [Late Orders]
			VAR YearCount = COUNTROWS(FILTER(ADDCOLUMNS(VALUES('Date'[Cal Year]), "@v", [Late Orders]), [@v] > 0))
			RETURN
			    YearCount & " years, " & SWITCH(TRUE(), Cur >= 1000000, FORMAT(Cur / 1000000, "0.00") & "M", Cur >= 10000, FORMAT(Cur / 1000, "0.0") & "k", FORMAT(Cur, "#,0")) & " late orders" & " from " & FORMAT([Shipped Orders], "#,0") & " shipped"
			        & ". Switch to Quarter or Month to see where inside a year the change came from." , REMOVEFILTERS('Date'[Cal Month], 'Date'[Cal Year]))
		lineageTag: e9a7dc16-ec6a-55cc-9f80-12423402a3e8

	/// The five-band key under the calendar.
	measure 'Cal Legend' =
			VAR Svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='640' height='20' viewBox='0 0 640 20' font-family='Segoe UI, sans-serif'>"
			        & "<text x='0' y='14' font-size='11' fill='#667284'>Lower</text><rect x='46' y='5' width='26' height='10' rx='1' fill='#E6E9F1'/><rect x='78' y='5' width='26' height='10' rx='1' fill='#BCC1D2'/><rect x='110' y='5' width='26' height='10' rx='1' fill='#7C8598'/><rect x='142' y='5' width='26' height='10' rx='1' fill='#3E4A66'/><rect x='174' y='5' width='26' height='10' rx='1' fill='#111F38'/>"
			        & "<text x='208' y='14' font-size='11' fill='#667284'>Higher</text>"
			        & "<text x='262' y='14' font-size='11' fill='#667284'>Shade = fifths of the cells shown &#183; &#8211; no late orders</text>"
			        & "</svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(Svg, "%", "%25"), "#", "%23")
		dataCategory: ImageUrl
		lineageTag: 723bb8e0-2505-50e5-836c-a2d4639bc85f

	column Placeholder
		dataType: string
		isHidden
		lineageTag: dce2dd7d-7794-5760-a512-0fa18a90bfa4
		summarizeBy: none
		sourceColumn: [Placeholder]

	partition 'Calendar Metrics' = calculated
		mode: import
		source = ROW("Placeholder", "")
